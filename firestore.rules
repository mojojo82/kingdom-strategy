rules_version = '2';
// Kingdom Strategy - Firestore rules (paste into Firebase console > Firestore > Rules, then Publish).
// Stage 1: only signed-in (anonymous) game clients can read/write. Stops random scripts hitting the database
// without the game. Tighter per-player rules come later, once player accounts are tied to Firebase sign-in.
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if request.auth != null;
    }
  }
}
